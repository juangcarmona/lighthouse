{
  "name": "@juangcarmona/lighthouse-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed engineering baseline for juangcarmona software products",
  "workspaces": [
    "src/packages/*"
  ],
  "scripts": {
    "markdownlint": "npx -y markdownlint-cli2@0.23.3",
    "test": "node --test src/tests/*.test.mjs",
    "build:public-site": "node scripts/build-public-site.mjs",
    "capture:public-site": "node scripts/capture-public-site.mjs",
    "preview:public-site": "npm run build:public-site && python3 -m http.server 4174 --directory dist/public-site",
    "verify:public-site": "npm run build:public-site && node scripts/verify-public-site.mjs",
    "verify": "npm run markdownlint && npm test && node scripts/check-doc-links.mjs && npm run verify:public-site",
    "verify:dotnet": "node src/packages/cli/internal/verify-dotnet.mjs",
    "verify:package-consumer": "node scripts/verify-package-consumer.mjs",
    "test:e2e": "playwright test --config src/gallery/playwright.config.mjs",
    "test:visual": "npm run test:e2e",
    "verify:all": "npm run verify && npm run verify:dotnet && npm run verify:adoption && npm run test:e2e",
    "verify:adoption": "node scripts/verify-adoption.mjs",
    "gallery": "node src/gallery/serve.mjs",
    "create:dotnet": "node src/packages/cli/internal/create-dotnet.mjs",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@arcshape/cli": "0.1.4",
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "2.31.1",
    "@fission-ai/openspec": "1.15.0",
    "@playwright/test": "1.64.1",
    "@prodshape/cli": "0.22.0"
  }
}
