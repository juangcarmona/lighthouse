mona/lighthouse/blob/main/.github/workflows/ci.yml","id":391121202,"name":"Lighthouse verification","node_id":"W_kwDOVRh-RM4XUAky","path":".github/workflows/ci.yml","state":"active","updated_at":"2026-10-20T23:30:57.000Z","url":"https://api.github.com/repos/juangcarmona/lighthouse/actions/workflows/391121202"},"workflow_run":{"actor":{"avatar_url":"https://avatars.githubusercontent.com/u/2834629?v=4","events_url":"https://api.github.com/users/juangcarmona/events{/privacy}","followers_url":"https://api.github.com/users/juangcarmona/followers","following_url":"https://api.github.com/users/juangcarmona/following{/other_user}","gists_url":"https://api.github.com/users/juangcarmona/gists{/gist_id}","gravatar_id":"","html_url":"https://github.com/juangcarmona","id":2834629,"login":"juangcarmona","node_id":"MDQ6VXNlcjI4MzQ2Mjk=","organizations_url":"https://api.github.com/users/juangcarmona/orgs","received_events_url":"https://api.github.com/users/juangcarmona/received_events","repos_url":"https://api.github.com/users/juangcarmona/repos","site_admin":false,"starred_url":"https://api.github.com/users/juangcarmona/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/juangcarmona/subscriptions","type":"User","url":"https://api.github.com/users/juangcarmona","user_view_type":"public"},"artifacts_url":"https://api.github.com/repos/juangcarmona/lighthouse/actions/runs/40506649821/artifacts","cancel_url":"https://api.github.com/repos/juangcarmona/lighthouse/actions/runs/40506649821/cancel","check_suite_id":109786689693,"check_suite_node_id":"CS_kwDOVRh-RM8AAAAZj8vwnQ","check_suite_url":"https://api.github.com/repos/juangcarmona/lighthouse/check-suites/109786689693","conclusion":"success","created_at":"2026-10-27T12:48:10Z","display_title":"Build and test repositories in reproducible agent environments (#129)","event":"push","head_branch":"main","head_commit":{"author":{"email":"41898282+github-actions[bot]@users.noreply.github.com","name":"github-actions[bot]"},"committer":{"email":"noreply@github.com","name":"GitHub"},"id":"496562b1deb8b217b231a0d7baad8d10889485b0","message":"Build and test repositories in reproducible agent environments (#129)\n\nAgents can now use a declared base or .NET environment with an isolated\nPostgreSQL service. Runs record the immutable image, check prerequisites\nbefore starting and clean up test services afterwards. The agent never\nreceives the host Docker socket.\n\nReal host acceptance is complete. Both images built successfully; SoFa\npassed 27 Node, 36 .NET and 4 browser tests inside the selected\ncontainer. Its two Docker engine tests passed on the host, and SoFa's\nunchanged full CI passed all 38 .NET tests. Lighthouse verification,\nreal container tests and this PR's CI are green.\n\nSoFa's explicit container/host verification split is in\njuangcarmona/sofa#64. [Acceptance report, logs and\nscreenshots](https://github.com/juangcarmona/lighthouse/blob/262195be8b594b6f3f7ada1a8f2bdba6af7c67d5/docs/process/20261027-125-execution-environments/README.md).\nThe report describes the limits of the cancellation test and separates\nsnapshot validation from the real-history security scan.\n\nReady for owner review. Production rollout and package release remain\nafter merge.\n\nCloses #125.\n\n<!--\nlighthouse-implementation:1bf1644769aa7bf31962040625c0d66d3f0e441f8cf3a5cdf2268e61e84a8b74\n-->\n\n---------\n\nCo-authored-by: github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>\nCo-authored-by: Juan G Carmona <juan@jgcarmona.com>","timestamp":"2026-10-27T12:48:06Z","tree_id":"7021b0e8a2d36df2bdfc4030bb31f3de00d6162c"},"head_repository":{"archive_url":"https://api.github.com/repos/juangcarmona/lighthouse/{archive_format}{/ref}","assignees_url":"https://api.github.com/repos/juangcarmona/lighthouse/assignees{/user}","blobs_url":"https://api.github.com/repos/juangcarmona/lighthouse/git/blobs{/sha}","branches_url":"https://api.github.com/repos/juangcarmona/lighthouse/branches{