{
  "schemaVersion": 1,
  "enabled": true,
  "routes": [
    "hotfix"
  ],
  "paths": [
    "src/packages/cli/src/lighthouse.mjs",
    "src/tests/lighthouse.test.mjs",
    ".changeset/fresh-git-hook-activation.md"
  ],
  "reviewerProfile": "fast",
  "allowFivePoint": false,
  "merge": true,
  "maxCorrections": 2,
  "timeoutSeconds": 3600,
  "hotfix": {
    "setupCommands": [
      [
        "npm",
        "ci",
        "--ignore-scripts"
      ]
    ],
    "testPaths": [
      "src/tests/lighthouse.test.mjs"
    ],
    "modules": {
      "cli": [
        "src/packages/cli/src/",
        "src/tests/lighthouse.test.mjs",
        ".changeset/fresh-git-hook-activation.md"
      ]
    },
    "regressionCommand": [
      "node",
      "--test",
      "--test-name-pattern",
      "activates installed hooks in a fresh Git repository",
      "src/tests/lighthouse.test.mjs"
    ],
    "failurePattern": [
      "ERR_ASSERTION"
    ]
  }
}
