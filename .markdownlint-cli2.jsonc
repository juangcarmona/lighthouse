// Markdown is linted, not reformatted: markdownlint-cli2 owns Markdown style in this repository.
// Prose is written as one logical paragraph per source line through the custom rule below.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    // ArcShape documents use front matter titles and an explicit reader-facing H1.
    "MD025": false,
    "no-hard-wrapped-prose": true
  },
  "customRules": [".markdownlint-rules.cjs"],
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/TestResults/**",
    "playwright-report/**",
    "test-results/**",
    // Generated by APM, OpenSpec and ProductShape, or copied by the lifecycle's adopt step.
    ".agents/**",
    "openspec/schemas/**",
    // ProductShape artifacts are authored and cited through Product Changes.
    "docs/product/model/**",
    "docs/product/changes/**",
    // The .NET SDK owns these release-note projections.
    "src/dotnet/**/AnalyzerReleases*.md"
  ]
}
