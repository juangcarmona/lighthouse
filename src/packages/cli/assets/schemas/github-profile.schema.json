{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/github-profile.schema.json",
  "title": "Optional Lighthouse GitHub repository profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileVersion",
    "repository",
    "intake",
    "requiredChecks",
    "requiredApprovals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
    },
    "intake": {
      "enum": [
        "preserve",
        "public",
        "collaborators"
      ]
    },
    "requiredApprovals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "integrationId"
        ],
        "properties": {
          "context": {
            "type": "string",
            "minLength": 1
          },
          "integrationId": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidenceBranch": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_/-]*$"
    },
    "releaseWorkflowReady": {
      "type": "boolean"
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository.has_issues": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.has_discussions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.is_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.allow_squash_merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.allow_merge_commit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.allow_rebase_merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.allow_auto_merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.allow_update_branch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.delete_branch_on_merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.web_commit_signoff_required": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.squash_merge_commit_title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                "PR_TITLE",
                "COMMIT_OR_PR_TITLE",
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "repository.squash_merge_commit_message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                "PR_BODY",
                "COMMIT_MESSAGES",
                "BLANK",
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actions.workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                null,
                {
                  "default_workflow_permissions": "read",
                  "can_approve_pull_request_reviews": false
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actions.forkApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                "all_external_contributors",
                "first_time_contributors",
                "first_time_contributors_new_to_github",
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "security.alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                true,
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "security.updates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                true,
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "security.secret_scanning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                "enabled",
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "security.secret_scanning_push_protection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                "enabled",
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "releases.immutable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "enum": [
                true,
                null
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rules.main": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rules.evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "reason"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
