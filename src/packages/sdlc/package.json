{
  "name": "@juangcarmona/lighthouse-sdlc",
  "version": "0.6.0",
  "type": "module",
  "description": "Provider-neutral SDLC skills, commands and route contracts for Lighthouse adopters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juangcarmona/lighthouse.git",
    "directory": "src/packages/sdlc"
  },
  "homepage": "https://juangcarmona.github.io/lighthouse/",
  "bugs": {
    "url": "https://github.com/juangcarmona/lighthouse/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "commands",
    "contract.json",
    "capabilities.json",
    "gates.json",
    "meta-commands",
    "README.md",
    "routes.json",
    "stages.json",
    "schemas",
    "skills",
    "src"
  ],
  "bin": {
    "lighthouse-sdlc": "./src/sdlc.mjs"
  },
  "exports": {
    ".": "./src/sdlc.mjs",
    "./triage": "./src/triage.mjs",
    "./contracts": "./src/contracts.mjs",
    "./control-plane": "./src/control-plane.mjs",
    "./decompose": "./src/decompose.mjs",
    "./github": "./src/github.mjs",
    "./memory": "./src/memory.mjs",
    "./routes": "./src/routes.mjs",
    "./reconcile": "./src/reconcile.mjs",
    "./capabilities": "./src/capabilities.mjs",
    "./stacked": "./src/stacked.mjs",
    "./workflow": "./src/workflow.mjs",
    "./browser-e2e": "./src/browser-e2e.mjs",
    "./contract.json": "./contract.json",
    "./schemas/control-plane.schema.json": "./schemas/control-plane.schema.json",
    "./schemas/triage.schema.json": "./schemas/triage.schema.json",
    "./schemas/stages.schema.json": "./schemas/stages.schema.json",
    "./schemas/stage-result.schema.json": "./schemas/stage-result.schema.json",
    "./schemas/workflow-state.schema.json": "./schemas/workflow-state.schema.json",
    "./schemas/decomposition.schema.json": "./schemas/decomposition.schema.json",
    "./schemas/capabilities.schema.json": "./schemas/capabilities.schema.json",
    "./schemas/capability-catalog.schema.json": "./schemas/capability-catalog.schema.json",
    "./schemas/browser-e2e.schema.json": "./schemas/browser-e2e.schema.json",
    "./capabilities.json": "./capabilities.json"
  }
}
