    "./reconcile": "./src/reconcile.mjs",
    "./capabilities": "./src/capabilities.mjs",
    "./aliases": "./src/aliases.mjs",
    "./stacked": "./src/stacked.mjs",
    "./workflow": "./src/workflow.mjs",
