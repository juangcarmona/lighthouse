    "./schemas/browser-e2e.schema.json": "./schemas/browser-e2e.schema.json",
    "./schemas/evidence-record.schema.json": "./schemas/evidence-record.schema.json",
    "./schemas/evidence-index.schema.json": "./schemas/evidence-index.schema.json",
    "./capabilities.json": "./capabilities.json",
    "./command-aliases.json": "./command-aliases.json",
    "./schemas/command-aliases.schema.json": "./schemas/command-aliases.schema.json",
    "./workflows/*": "./workflows/*",
    "./host-contract": "./src/host-contract.mjs",
    "./github-profile": "./src/github-profile.mjs",
    "./product-change": "./src/product-change.mjs",
