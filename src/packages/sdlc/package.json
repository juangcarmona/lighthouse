    "./schemas/control-plane.schema.json": "./schemas/control-plane.schema.json",
    "./schemas/triage.schema.json": "./schemas/triage.schema.json",
    "./schemas/stages.schema.json": "./schemas/stages.schema.json",
    "./schemas/stage-result.schema.json": "./schemas/stage-result.schema.json",
    "./schemas/workflow-state.schema.json": "./schemas/workflow-state.schema.json",
