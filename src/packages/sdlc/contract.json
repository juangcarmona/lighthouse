{
  "$schema": "./schemas/sdlc-contract.schema.json",
  "name": "@juangcarmona/lighthouse-sdlc",
  "version": "0.5.0",
  "stages": [
    { "name": "triage", "skill": "skills/triage/SKILL.md", "command": "commands/triage.md", "gate": "triaged" },
    { "name": "refine", "skill": "skills/refine/SKILL.md", "command": "commands/refine.md", "gate": "ready" },
    { "name": "propose", "skill": "skills/propose/SKILL.md", "command": "commands/propose.md", "gate": "planned" },
    { "name": "implement", "skill": "skills/implement/SKILL.md", "command": "commands/implement.md", "gate": "done" },
    { "name": "integrate", "skill": "skills/integrate/SKILL.md", "command": "commands/integrate.md", "gate": "done" },
    { "name": "review", "skill": "skills/review/SKILL.md", "command": "commands/review.md", "gate": null }
  ],
  "utilities": ["status", "route", "state", "stage-result", "control-plane", "memory", "launch", "decompose", "stacked", "github-triage", "github-decompose", "reconcile-labels", "github-labels"],
  "routes": ["supervised", "plan-only", "unattended", "hotfix", "stacked"],
  "metaCommands": ["ff", "hotfix", "decompose", "stacked"],
  "gates": ["triaged", "ready", "planned", "done"],
  "assets": {
    "routes": "routes.json",
    "gates": "gates.json",
    "stages": "stages.json",
    "controlPlaneSchema": "schemas/control-plane.schema.json",
    "triageSchema": "schemas/triage.schema.json",
    "stageResultSchema": "schemas/stage-result.schema.json",
    "stateSchema": "schemas/workflow-state.schema.json",
    "decompositionSchema": "schemas/decomposition.schema.json",
    "capabilitiesSchema": "schemas/capabilities.schema.json",
    "capabilityCatalog": "capabilities.json",
    "capabilityCatalogSchema": "schemas/capability-catalog.schema.json"
  }
}
