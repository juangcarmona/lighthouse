{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/sdlc-gates.schema.json",
  "title": "Lighthouse SDLC gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "gates"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "question", "decisionOwner"],
      "properties": {
        "id": { "type": "string" },
        "stage": { "type": "string" },
        "question": { "type": "string" },
        "decisionOwner": { "type": "string" }
      }
    }
  }
}
