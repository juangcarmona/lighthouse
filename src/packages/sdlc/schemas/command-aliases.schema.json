{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/lighthouse-sdlc-command-aliases.schema.json",
  "title": "Lighthouse SDLC command aliases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "package", "canonicalNamespace", "aliasNamespace", "aliases"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"const": "@juangcarmona/lighthouse-sdlc"}}
    },
    "canonicalNamespace": {"const": "/lighthouse"},
    "aliasNamespace": {"const": "/lh"},
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "canonical", "asset"],
        "properties": {
          "alias": {"type": "string", "pattern": "^/lh:[a-z][a-z0-9-]*$"},
          "canonical": {"type": "string", "pattern": "^/lighthouse:[a-z][a-z0-9-]*$"},
          "asset": {"type": "string", "pattern": "^(commands|meta-commands)/[a-z0-9-]+\\.md$"}
        }
      }
    }
  }
}
