{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/capability-catalog.schema.json",
  "title": "Lighthouse adoptable capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@juangcarmona/lighthouse-sdlc" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "adapter", "version", "title", "selection", "configuration", "operations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "selection": { "enum": ["selected-by-default", "opt-in"] },
          "configuration": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "roles": { "type": "array", "items": { "enum": ["state", "command", "classification"] } },
              "labels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "role", "description"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "role": { "enum": ["state", "command", "classification"] },
                    "dimension": { "type": "string" },
                    "value": { "type": "string" },
                    "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                    "description": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to"],
                  "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
                }
              },
              "transitionPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "description"],
                "properties": {
                  "mode": { "enum": ["declared-only"] },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "operations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "blocked"],
            "properties": {
              "allowed": { "type": "array", "items": { "enum": ["create", "preserve", "modify", "rename", "remove", "ambiguous", "unsupported"] } },
              "blocked": { "type": "array", "items": { "enum": ["create", "preserve", "modify", "rename", "remove", "ambiguous", "unsupported"] } }
            }
          }
        }
      }
    }
  }
}
