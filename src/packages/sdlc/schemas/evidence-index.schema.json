{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/lighthouse-evidence-index.schema.json",
  "title": "Lighthouse evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indexId", "runId", "records", "coverage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "indexId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/recordRef" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "kind", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "unavailable", "unconfigured", "pending-review", "not-applicable"] },
        "subject": { "$ref": "#/$defs/subject" },
        "authorityRefs": { "type": "array", "items": { "$ref": "#/$defs/authorityRef" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "status", "evidenceIds"],
      "properties": {
        "subject": { "$ref": "#/$defs/subject" },
        "status": { "enum": ["unverified", "observed", "verified", "incomplete", "conflict", "not-applicable"] },
        "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
