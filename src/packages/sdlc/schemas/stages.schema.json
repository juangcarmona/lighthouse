{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/sdlc-stages.schema.json",
  "title": "Lighthouse SDLC stages",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "gate", "input", "output", "mutation"],
      "properties": {
        "id": { "type": "string" },
        "gate": { "type": ["string", "null"] },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "mutation": { "enum": ["none", "explicit", "workspace"] }
      }
    }
  }
}
