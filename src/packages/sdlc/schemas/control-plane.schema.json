{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/lighthouse-sdlc-control-plane.schema.json",
  "title": "Lighthouse SDLC control plane",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "routes", "gates", "state", "memory", "roles", "adapters"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@juangcarmona/lighthouse-sdlc" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "routes": { "type": "array", "items": { "type": "string" } },
    "gates": { "type": "array", "items": { "type": "string" } },
    "state": { "type": "object", "additionalProperties": false, "required": ["provider"], "properties": { "provider": { "type": "string" }, "states": { "type": "array", "items": { "enum": ["ready", "running", "waiting-human", "blocked", "succeeded", "failed", "cancelled"] } } } },
    "memory": { "type": "object", "additionalProperties": false, "required": ["provider", "scopes"], "properties": { "provider": { "type": "string" }, "scopes": { "type": "array", "items": { "enum": ["run", "project", "shared"] } }, "shared": { "type": "boolean" } } },
    "roles": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/role" }] } },
    "adapters": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSchema", "outputSchema", "tools", "writeScope"],
      "properties": {
        "inputSchema": { "type": "string" },
        "outputSchema": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "writeScope": { "type": "array", "items": { "type": "string" } },
        "limits": { "type": "object" },
        "stopConditions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
