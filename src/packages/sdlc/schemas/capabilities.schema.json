{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/lighthouse-capabilities.schema.json",
  "title": "Lighthouse capability declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "configuration": { "type": "object" }
        }
      }
    }
  }
}
