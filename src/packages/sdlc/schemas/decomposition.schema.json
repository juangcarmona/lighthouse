{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/lighthouse-decomposition.schema.json",
  "title": "Lighthouse decomposition input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "parent", "slices"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "parent": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": true },
    "slices": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "acceptance", "dependencies"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "acceptance": { "type": "array", "items": { "type": "string" } }, "dependencies": { "type": "array", "items": { "type": "string" } }, "scope": { "type": "array", "items": { "type": "string" } }, "labels": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true } }
  }
}
