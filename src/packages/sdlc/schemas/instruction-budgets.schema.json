{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed SDLC instruction budgets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "coverage", "branches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "method": { "const": "raw-utf8-whole-file-sha256-v1" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "uncoveredBranches", "limitations"],
      "properties": {
        "included": { "type": "string", "minLength": 1 },
        "excluded": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "uncoveredBranches": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "string", "minLength": 1 }
      }
    },
    "branches": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/branch" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*(?:\\.[a-zA-Z0-9]+)+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "references", "combined"],
      "properties": {
        "entry": { "type": "integer", "minimum": 1 },
        "references": { "type": "integer", "minimum": 1 },
        "combined": { "type": "integer", "minimum": 1 }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry", "references", "totals", "caps", "capReview"],
      "properties": {
        "id": { "enum": ["refine-direct-no-view", "refine-proposed-visual", "implement-scoped-no-view", "implement-existing-view"] },
        "entry": { "$ref": "#/$defs/source" },
        "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "totals": { "$ref": "#/$defs/totals" },
        "caps": { "$ref": "#/$defs/totals" },
        "capReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "reason"],
          "properties": {
            "method": { "const": "implementation-source-review" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
