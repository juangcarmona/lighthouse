{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juangcarmona/lighthouse/schemas/sdlc-routes.schema.json",
  "title": "Lighthouse SDLC routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "routes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/route" } }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stages", "humanGates"],
      "properties": {
        "id": { "type": "string" },
        "stages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "humanGates": { "type": "array", "items": { "type": "string" } },
        "requires": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
