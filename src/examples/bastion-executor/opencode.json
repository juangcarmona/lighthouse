{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/workspace/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/input/context.json",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/output/envelope.json",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/output/envelope.json",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/workspace/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/input/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/output/*",
      "effect": "allow"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/workspace",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "*:*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:/workspace/*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "read:/input/context.json",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "read:/output/envelope.json",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "edit:/output/envelope.json",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:/workspace/*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:/input/*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "external_directory:/output/*",
      "effect": "allow"
    },
    {
      "action": "tool.use",
      "resource": "execute:*",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:/workspace",
      "effect": "allow"
    }
  ]
}
