FROM docker:29.1.3-cli AS docker-cli
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git gh jq libicu72 libkrb5-3 libssl3 libunwind8 util-linux && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY src/packages/sdlc /opt/lighthouse-sdlc
# Mount a separately registered runner, its home and telemetry state at their host paths.
ENTRYPOINT ["node", "/opt/lighthouse-sdlc/src/telemetry-runner.mjs", "run", "--", "/bin/bash", "./run.sh"]
