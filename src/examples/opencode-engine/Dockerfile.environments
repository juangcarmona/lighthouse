# Supply an immutable node:24-bookworm-slim digest; no mutable default.
ARG NODE_IMAGE
ARG SDK_IMAGE
FROM ${NODE_IMAGE} AS base
ARG OPENCODE_SHA256
RUN printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260201T000000Z bookworm main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260201T000000Z bookworm-security main\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends ca-certificates git ripgrep chromium libicu72 libssl3 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 20003 --create-home engine
COPY opencode /usr/local/bin/opencode
RUN echo "${OPENCODE_SHA256}  /usr/local/bin/opencode" | sha256sum --check -
COPY opencode-implement.json /etc/opencode/opencode.json
COPY entrypoint.sh /usr/local/bin/lighthouse-engine
RUN chmod 644 /etc/opencode/*.json && chmod 755 /etc/opencode /usr/local/bin/opencode /usr/local/bin/lighthouse-engine \
    && mkdir -p /execution /input /output /home/engine/.local/share/opencode /home/engine/.cache \
    && chown -R 20003:20003 /home/engine
ENV HOME=/home/engine PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium CHROMIUM_PATH=/usr/bin/chromium
USER 20003:20003
WORKDIR /execution
ENTRYPOINT ["/usr/local/bin/lighthouse-engine"]

FROM ${SDK_IMAGE} AS sdk
FROM base AS dotnet
USER 0:0
COPY --from=sdk /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
    && test "$(dotnet --version)" = '10.0.100'
ENV DOTNET_ROOT=/usr/share/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1
USER 20003:20003
